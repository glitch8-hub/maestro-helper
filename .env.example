# Copy this to .env.local and fill in the values from your Firebase project.
# .env.local is gitignored so your real values stay out of GitHub.
# For production builds, set these as GitHub repo secrets (see SETUP.md).

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Workspace ID is the shared "namespace" your devices read/write to.
# Pick anything you like; all your devices need the same value to share data.
VITE_WORKSPACE_ID=wayward-main
